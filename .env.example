AWS_REGION=us-east-2
AWS_PROFILE=default
LOCAL_UID=1000
LOCAL_GID=1000
CLASSLENS_UPLOADS_BUCKET=replace-with-private-bucket-name-from-sam
CLASSLENS_JOBS_TABLE=replace-with-jobs-table-name-from-sam
CLASSLENS_QUEUE_URL=replace-with-jobs-queue-url-from-sam
BEDROCK_MODEL_ID=google.gemma-4-31b
BEDROCK_MANTLE_REGION=us-east-2
MAX_UPLOAD_MB=500
MAX_DURATION_SECONDS=10800
FRAME_INTERVAL_SECONDS=8
MAX_FRAMES=48
RETENTION_DAYS=7
# Leave these blank to use real AWS DynamoDB and SQS. Set them only for a local emulator.
CLASSLENS_DYNAMODB_ENDPOINT_URL=
CLASSLENS_SQS_ENDPOINT_URL=
# Transcribe, Bedrock, S3, DynamoDB, and SQS use the AWS profile mounted from ~/.aws.
